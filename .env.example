# Database. SQLite works for local development.
# For production, switch the provider in prisma/schema.prisma to "postgresql" and use a Postgres URL.
DATABASE_URL="file:./dev.db"

# Secret used to sign login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Comma-separated emails that get the admin (safety team) role when they sign up.
ADMIN_EMAILS="founder@example.com"

# Razorpay (https://dashboard.razorpay.com/app/keys). Leave empty to keep payments switched off.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret from Razorpay Dashboard → Webhooks (event: payment.captured, URL: /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=""

# Public contact details shown on Terms / Privacy (required by the IT Rules, 2021).
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_GRIEVANCE_OFFICER=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
