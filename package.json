{
  "name": "heartsync",
  "version": "0.1.0",
  "private": true,
  "description": "HeartSync — talk to a verified big bro or big sis. Peer support, not therapy.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
